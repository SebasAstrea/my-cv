---
/**
 * Layout base — `RF-06`, `RUI-81`, `RNF-33`, `RF-09`.
 *
 * Decisiones que no son obvias:
 *
 * - El HTML es estatico y completo: sin JS, el CV entero se lee en orden (`RF-07`, `SUP-05`).
 *   El unico script inline es el que aplica el tema, y hace falta porque `RF-09` exige que la
 *   eleccion se respete ANTES de la primera pintura: sin un script bloqueante en `<head>`,
 *   la primera pintura sale con el tema por defecto y luego parpadea.
 * - Ese script es la unica excepcion a `RNF-62` (`unsafe-inline` solo con hash/nonce). El hash
 *   sha256 se calcula y se fija en el Sprint 9; queda anotado ahi como tarea, no aqui como
 *   excusa.
 */

import '../styles/global.css'
import { siteUrl } from '../lib/env.ts'
import ThemeToggle from '../components/ThemeToggle.astro'

interface Props {
  title: string
  description: string
  /** `RF-09`/`ABR-03`: espanol unico en v1. El atributo `lang` es real, no decorativo. */
  lang?: 'es'
  /** Bloquea de tema actual, para que el servidor pueda fijar el color de fondo. */
  theme?: 'dark' | 'light'
}

const {
  title,
  description,
  lang = 'es',
  theme = 'dark',
} = Astro.props

const canonical = new URL(Astro.url.pathname, siteUrl()).toString()
---

<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* `RUI-17`: preload de las 2 fuentes criticas (display + ui); maximo 2. */}
    <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />

    {/*
      `RF-09`: la preferencia se aplica antes de la primera pintura. Bloqueante a proposito:
      si se difiere, hay flash. El valor por defecto es `prefers-color-scheme`.
      CSP: hash sha256 pendiente de fijar en el Sprint 9 (`RNF-62`).
    */}
    <script is:inline>
      ;(() => {
        try {
          const saved = localStorage.getItem('theme')
          const prefersLight = matchMedia('(prefers-color-scheme: light)').matches
          document.documentElement.dataset.theme = saved ?? (prefersLight ? 'light' : 'dark')
        } catch {
          document.documentElement.dataset.theme = 'dark'
        }
      })()
    </script>

    <slot name="head" />
  </head>

  <body>
    {/* `RF-06` / WCAG 2.4.1: primer elemento enfocable de la pagina. */}
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    {/* `DEC-02.b`: UN solo `<video>` en todo el DOM, detras del contenido y decorativo
        (`aria-hidden`). El clip de la escena activa lo recicla `src/scripts/video.ts`. */}
    <div class="stage" data-stage aria-hidden="true">
      <img class="stage__poster" data-stage-poster alt="" decoding="async" />
      <video
        class="stage__video"
        data-stage-video
        muted
        playsinline
        preload="none"
        tabindex="-1"
      ></video>
    </div>

    <header>
      <slot name="header" />
      <ThemeToggle />
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <footer>
      <slot name="footer" />
    </footer>

    {/* `RF-45`: controles manuales de video, alcanzables por teclado. */}
    <div class="video-controls" role="group" aria-label="Controles de vídeo">
      <button type="button" class="video-controls__btn" data-video-toggle aria-pressed="false">
        Vídeo: auto
      </button>
      <button type="button" class="video-controls__btn" data-video-pause>Pausar</button>
      <button type="button" class="video-controls__btn" data-video-restart>Reiniciar</button>
    </div>

    {/* Chromium del sitio que no pertenece a ninguna escena: la burbuja del chat, que va fija
        (`RF-50..58`, `ADR-0012`). Va en un slot para que `Base` siga sin saber del CV. */}
    <slot name="overlay" />

    {/*
      `RF-02..05`, `RF-09`: navegacion, estado del rail, deep-link y tema. Modulo diferido:
      no bloquea la ruta critica (`RNF-08`) y sin el el CV se lee entero (`RF-07`).
    */}
    <script>
      import '../scripts/nav.ts'
    </script>

    {/* `DEC-02`, `RF-10`, `RF-40..45`, `RUI-95/96`, `RNF-55`: sistema de video por escenas. */}
    <script>
      import '../scripts/video.ts'
    </script>

    {/* `RF-51..58`: panel de consulta. Diferido como el resto; sin el, el CV se lee entero. */}
    <script>
      import '../scripts/chat.ts'
    </script>
  </body>
</html>
