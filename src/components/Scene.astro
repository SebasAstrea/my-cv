---
/**
 * Cabecera de escena: numeracion editorial, timecode real y heading enfocable.
 *
 * `RF-01`  cada escena tiene un `h2` con id estable `#escena-0N`.
 * `RUI-60.a` la numeracion `00/07 ... 06/07` va en el margen, no en el centro.
 * `RUI-60.b` los timecodes son reales: salen del storyboard, no son decorativos.
 * `RUI-82` cada escena es `<section aria-labelledby>` y su heading es enfocable con
 *           `tabindex="-1"` para que `RF-05` pueda mover el foco a el con el teclado.
 */

import type { SceneMeta } from '../data/storyboard.ts'
import { clipUrl, posterUrl } from '../data/clips.ts'

interface Props {
  meta: SceneMeta
  /** Nombre visible de la escena. El contenido de la escena va en el slot. */
  title: string
  /** Parrafo de apoyo. `RUI-30`: uno por escena, <= 45ch. */
  support?: string
  class?: string
  /**
   * Nivel del heading. `RUI-81` exige UN solo `h1` en la pagina: la escena 00 usa 1 y el
   * resto 2. Es un prop y no `title` + markup propio para que `aria-labelledby` siga
   * cuadrando en un unico sitio.
   */
  level?: 1 | 2
}

const { meta, title, support, class: className, level = 2 } = Astro.props
const headingId = `${meta.anchor}-titulo`
const Heading = level === 1 ? 'h1' : 'h2'

// `RF-40`: cada escena declara su clip y su poster; el `<video>` unico los recicla (`DEC-02.b`).
const clip = clipUrl(meta.index)
const poster = posterUrl(meta.index)
---

<section
  id={meta.anchor}
  class:list={['scene', className]}
  data-split={meta.split}
  data-scene={meta.id}
  data-scene-index={meta.index}
  data-clip={clip}
  data-poster={poster}
  aria-labelledby={headingId}
>
  <div class="scene-split">
    <div class="col-primary">
      <div class="scene__meta">
        <span class="scene-number">{meta.counter}</span>
        <span class="mono" data-testid="timecode">{meta.progress}</span>
        <span class="mono">{meta.durationLabel}</span>
      </div>

      <div class="scene__heading">
        <Heading id={headingId} tabindex="-1">
          {title}
        </Heading>
        {support !== undefined && <p class="support">{support}</p>}
      </div>
    </div>

    <div class="col-secondary">
      <slot />
    </div>
  </div>
</section>
