{
  "name": "my-cv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portafolio / CV 'Dossier'. Sitios de una pagina con direccion de arte propia, renderizado en servidor y chat de IA con guardrails. Ver docs/SPEC.md.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "clips": "node scripts/sync-clips.mjs",
    "dev": "node scripts/sync-clips.mjs && astro dev",
    "build": "node scripts/sync-clips.mjs && astro build",
    "preview": "astro preview",
    "status": "node scripts/status.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:cv": "node --experimental-strip-types scripts/check-cv.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "gate:tokens": "node --experimental-strip-types scripts/gate-tokens.mjs",
    "gate:ats": "node scripts/gate-ats.mjs",
    "gate:security": "node scripts/gate-security.mjs",
    "gate:keyboard": "node scripts/gate-keyboard.mjs",
    "gate:saturation": "node scripts/gate-saturation.mjs",
    "gate:video": "node scripts/gate-video.mjs",
    "gate:placeholders": "node scripts/gate-placeholders.mjs",
    "gate:budgets": "node scripts/gate-budgets.mjs",
    "gate:artifacts": "node --experimental-strip-types scripts/gate-artifacts.mjs",
    "gate": "pnpm status && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm check:cv && pnpm gate:tokens && pnpm build && pnpm gate:ats && pnpm gate:security && pnpm gate:placeholders && pnpm gate:budgets && pnpm gate:artifacts",
    "verify": "pnpm gate",
    "medir:estatico": "node --experimental-strip-types scripts/medir-estatico.mjs",
    "medir:lab": "node --experimental-strip-types scripts/medir-lab.mjs",
    "medir:lab:rapido": "node --experimental-strip-types scripts/medir-lab.mjs --rapido",
    "medir:diseno": "python3 scripts/medir-diseno.py",
    "medir:graficas": "node --experimental-strip-types scripts/graficas.mjs",
    "medir": "pnpm build && pnpm medir:estatico && pnpm medir:lab && pnpm medir:diseno && pnpm medir:graficas"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "1.63.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0"
  }
}
