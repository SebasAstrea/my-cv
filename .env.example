CV_DATA_SOURCE=fixture
PUBLIC_SITE_URL=http://localhost:4321
# `RF-27` / ADR-0006: email de contacto publico que se revela bajo interaccion. Si no se define,
# la escena de contacto solo muestra LinkedIn/GitHub. Es PUBLIC: Vite lo inyecta en el cliente.
# PUBLIC_CONTACT_EMAIL=contacto@tu-dominio
# Chat (ADR-0008). Por defecto esta encendido y el proveedor es "off": el unico implementado,
# que responde desde el corpus sin salir a la red. Se pueden apagar sin tocar codigo.
#   CHAT_ENABLED=0     -> POST /api/chat responde 404, la ruta no existe
#   MODEL_PROVIDER=off -> valor por defecto; cualquier otro valor lanza hasta cerrar ABR-01
# MODEL_PROVIDER=off
# CHAT_ENABLED=1
