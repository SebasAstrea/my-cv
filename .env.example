CV_DATA_SOURCE=fixture
PUBLIC_SITE_URL=http://localhost:4321
# `RF-27` / ADR-0006: email de contacto publico que se revela bajo interaccion. Si no se define,
# la escena de contacto solo muestra LinkedIn/GitHub. Es PUBLIC: Vite lo inyecta en el cliente.
# PUBLIC_CONTACT_EMAIL=contacto@tu-dominio
# Chat (ADR-0008). Por defecto esta encendido y el proveedor es "off": responde desde el corpus sin
# salir a la red. Se pueden apagar sin tocar codigo.
#   CHAT_ENABLED=0     -> POST /api/chat responde 404, la ruta no existe
#   MODEL_PROVIDER=off -> sin salida a la red; es el valor por defecto y el fallback de Groq
#   MODEL_PROVIDER=groq -> llama a openai/gpt-oss-120b (ADR-0009). Sin GROQ_API_KEY degrada a "off"
# MODEL_PROVIDER=off
# CHAT_ENABLED=1

# Clave del modelo. SOLO en el servidor: nunca en un `PUBLIC_` ni en el cliente. Sin ella, Groq no
# se activa. En Vercel: Settings -> Environment Variables. Es una credencial: si se filtra, se
# revoca y se genera otra, no se rota en el repositorio.
# GROQ_API_KEY=

# Tasa por IP y por minuto (RNF-68, decision del PO). Por defecto 10. OJO: la ventana vive en la
# memoria de la instancia, asi que es una mitigacion, no un maximo global (TD-12).
# CHAT_RATE_PER_MIN=10
